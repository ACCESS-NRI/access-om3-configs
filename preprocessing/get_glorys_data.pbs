#!/bin/bash
#PBS -N get_glorys_data
#PBS -P tm70
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=10:00:00
#PBS -l wd
#PBS -l storage=scratch/tm70+gdata/tm70+gdata/vk83
