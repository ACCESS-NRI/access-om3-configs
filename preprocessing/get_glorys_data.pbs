module use /g/data/vk83/modules
module load copernicusmarine/2.4.1

copernicusmarine subset --dataset-id cmems_mod_glo_phy_my_0.083deg_P1D-m --variable so --variable thetao --variable uo --variable vo --variable zos --start-datetime 2012-01-01T00:00:00 --end-datetime 2012-01-02T00:00:00 --minimum-longitude 142.76 --maximum-longitude 150.24 --minimum-latitude -48.24 --maximum-latitude -38.71 --minimum-depth 0 --maximum-depth 6000 -o /g/data/tm70/hm6113/tmp/access-rom3-demo -f ic_unprocessed.nc


